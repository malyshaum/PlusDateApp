# Build stage
FROM node:22-alpine AS builder

WORKDIR /app

# Declare build arguments
ARG VITE_MODE=prod
ARG VITE_API_URL
ARG VITE_SOCKET_AUTH_URL
ARG VITE_SOCKET_HOST
ARG VITE_SOCKET_PORT
ARG VITE_GTM_TOKEN

# Make them available as ENV for the build
ENV VITE_MODE=$VITE_MODE
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SOCKET_AUTH_URL=$VITE_SOCKET_AUTH_URL
ENV VITE_SOCKET_HOST=$VITE_SOCKET_HOST
ENV VITE_SOCKET_PORT=$VITE_SOCKET_PORT
ENV VITE_GTM_TOKEN=$VITE_GTM_TOKEN

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build the application based on mode
RUN if [ "$BUILD_MODE" = "staging" ]; then \
      npm run build:staging; \
    else \
      npm run build; \
    fi

# Production stage
FROM nginx:alpine

# Copy built files to nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom nginx config
COPY nginx.conf /etc/nginx/nginx.conf

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
